{
  "name": "dsh-dice-tool",
  "version": "0.1.0",
  "description": "A minimal DeepSeek Harness tool plugin: roll dice from the chat.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": ["index.js", "cordis.patch.yml", "locale/en.json", "locale/zh.json", "icon.svg"],
  "icon": "./icon.svg",
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-tools": "*"
  },
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } }
}
